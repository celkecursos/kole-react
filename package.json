{
  "name": "@celke/kole-react",
  "version": "0.1.0",
  "description": "Biblioteca de componentes React para sistemas administrativos.",
  "license": "MIT",
  "author": "Cesar Szpak",
  "homepage": "https://github.com/celkecursos/kole-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celkecursos/kole-react.git"
  },
  "bugs": {
    "url": "https://github.com/celkecursos/kole-react/issues"
  },
  "keywords": [
    "react",
    "ui",
    "componentes",
    "design-system",
    "layout",
    "admin",
    "dashboard",
    "formulario",
    "tabela",
    "pt-br",
    "celke"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./estilos.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/estilos.css"
    },
    "./tokens.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/ajustar-tipos.mjs && node scripts/embutir-fonte.mjs",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.60.0"
  }
}
